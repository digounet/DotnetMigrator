<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="LegacyShop.Worker.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <add key="IntervaloMinutos" value="15" />
    <add key="ErpEndpoint" value="http://erp.interno:8080/integracao" />
  </appSettings>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=srv-sql01;Initial Catalog=LegacyShop;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <applicationSettings>
    <LegacyShop.Worker.Properties.Settings>
      <setting name="PastaExportacao" serializeAs="String">
        <value>C:\Exportacao\Estoque</value>
      </setting>
      <setting name="NotificarFalhas" serializeAs="String">
        <value>True</value>
      </setting>
    </LegacyShop.Worker.Properties.Settings>
  </applicationSettings>
  <log4net>
    <appender name="EventLog" type="log4net.Appender.EventLogAppender">
      <applicationName value="LegacyShop.Worker" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %-5level %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="WARN" />
      <appender-ref ref="EventLog" />
    </root>
  </log4net>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="EstoqueSoap" maxReceivedMessageSize="10485760" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://erp.interno/EstoqueService.svc" binding="basicHttpBinding" bindingConfiguration="EstoqueSoap" contract="Erp.IEstoqueService" name="EstoqueSoap" />
    </client>
  </system.serviceModel>
</configuration>
