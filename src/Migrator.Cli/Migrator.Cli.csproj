<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>migrator</AssemblyName>
    <RootNamespace>Migrator.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrator</ToolCommandName>
    <PackageId>Migrator.NetFramework</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Migrator.Core\Migrator.Core.csproj" />
  </ItemGroup>
</Project>
